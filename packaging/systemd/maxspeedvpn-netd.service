[Unit]
Description=MaxSpeedVPN network coordinator
After=network-online.target dbus.service
Wants=network-online.target

[Service]
Type=dbus
BusName=com.maxspeedvpn.Netd1
ExecStart=/usr/lib/maxspeedvpn/maxspeedvpn-netd
User=maxspeedvpn
Group=maxspeedvpn
RuntimeDirectory=maxspeedvpn
StateDirectory=maxspeedvpn
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
