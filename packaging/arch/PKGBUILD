pkgname=maxspeedvpn-linux
pkgver=0.1.0
pkgrel=1
pkgdesc='MaxSpeedVPN client for Arch Linux'
arch=('x86_64')
url='https://github.com/envywook/MaxSpeedVPN-Linux'
license=('GPL-3.0-only')
depends=('glibc' 'zlib' 'icu' 'fontconfig' 'libx11' 'libice' 'libsm')
makedepends=('dotnet-sdk')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "MaxSpeedVPN-Linux-$pkgver/v2rayN"
  dotnet publish v2rayN.Desktop/v2rayN.Desktop.csproj \
    --configuration Release \
    --runtime linux-x64 \
    --self-contained true \
    -p:PublishSingleFile=false \
    -p:DebugType=None \
    -p:DebugSymbols=false \
    --output "$srcdir/publish"
}

package() {
  install -d "$pkgdir/opt/maxspeedvpn"
  cp -a "$srcdir/publish/." "$pkgdir/opt/maxspeedvpn/"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/maxspeedvpn" <<'EOF'
#!/bin/sh
exec /opt/maxspeedvpn/v2rayN "$@"
EOF

  install -Dm644 "$srcdir/MaxSpeedVPN-Linux-$pkgver/packaging/arch/maxspeedvpn.desktop" \
    "$pkgdir/usr/share/applications/maxspeedvpn.desktop"
  install -Dm644 "$srcdir/MaxSpeedVPN-Linux-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/MaxSpeedVPN-Linux-$pkgver/NOTICE" \
    "$pkgdir/usr/share/doc/$pkgname/NOTICE"
  install -Dm644 "$srcdir/MaxSpeedVPN-Linux-$pkgver/THIRD_PARTY_NOTICES.md" \
    "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY_NOTICES.md"
}
