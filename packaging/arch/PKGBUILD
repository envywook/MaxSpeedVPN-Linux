pkgname=maxspeedvpn-linux
pkgver=0.1.0
pkgrel=1
pkgdesc='MaxSpeedVPN client for Arch Linux'
arch=('x86_64')
url='https://github.com/envywook/MaxSpeedVPN-Linux'
license=('GPL-3.0-only')
depends=('glibc' 'zlib' 'icu' 'fontconfig' 'libx11' 'libice' 'libsm')
makedepends=('dotnet-sdk')
source=(
  "MaxSpeedVPN-Linux-${pkgver}.tar.gz::https://github.com/envywook/MaxSpeedVPN-Linux/archive/refs/tags/v${pkgver}-alpha.tar.gz"
  "GlobalHotKeys.tar.gz::https://github.com/2dust/GlobalHotKeys/archive/162d401dfe0140b41d1fa349b9aadb4060e739b1.tar.gz"
  "v2rayN-core-bin.zip::https://github.com/2dust/v2rayN-core-bin/raw/00107fb83fabdce90bb402a79ec3d9631f26f16d/v2rayN-linux-64.zip"
)
sha256sums=(
  'SKIP'
  'SKIP'
  'd35f5527c6338b376676aa518eaf1852708bc28f8b5fac45306b58c8e2bbe898'
)

prepare() {
  rm -rf "MaxSpeedVPN-Linux-${pkgver}-alpha/v2rayN/GlobalHotKeys"
  cp -a "GlobalHotKeys-162d401dfe0140b41d1fa349b9aadb4060e739b1" \
    "MaxSpeedVPN-Linux-${pkgver}-alpha/v2rayN/GlobalHotKeys"
}

build() {
  cd "MaxSpeedVPN-Linux-${pkgver}-alpha/v2rayN"
  dotnet publish v2rayN.Desktop/v2rayN.Desktop.csproj \
    --configuration Release \
    --runtime linux-x64 \
    --self-contained true \
    -p:PublishSingleFile=false \
    -p:DebugType=None \
    -p:DebugSymbols=false \
    --output "$srcdir/publish"
}

package() {
  install -d "$pkgdir/opt/maxspeedvpn"
  cp -a "$srcdir/publish/." "$pkgdir/opt/maxspeedvpn/"
  cp -a "$srcdir/v2rayN-linux-64/." "$pkgdir/opt/maxspeedvpn/"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/maxspeedvpn" <<'EOF'
#!/bin/sh
exec /opt/maxspeedvpn/v2rayN "$@"
EOF

  install -Dm644 "$srcdir/MaxSpeedVPN-Linux-${pkgver}-alpha/packaging/arch/maxspeedvpn.desktop" \
    "$pkgdir/usr/share/applications/maxspeedvpn.desktop"
  install -Dm644 "$srcdir/MaxSpeedVPN-Linux-${pkgver}-alpha/v2rayN/v2rayN.Desktop/v2rayN.png" \
    "$pkgdir/usr/share/pixmaps/maxspeedvpn.png"
  install -Dm644 "$srcdir/MaxSpeedVPN-Linux-${pkgver}-alpha/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/MaxSpeedVPN-Linux-${pkgver}-alpha/NOTICE" \
    "$pkgdir/usr/share/doc/$pkgname/NOTICE"
  install -Dm644 "$srcdir/MaxSpeedVPN-Linux-${pkgver}-alpha/THIRD_PARTY_NOTICES.md" \
    "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY_NOTICES.md"
  chmod 755 "$pkgdir/usr/share/doc"
}
