<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>MaxSpeedVPN</vendor>
  <vendor_url>https://github.com/envywook/MaxSpeedVPN-Linux</vendor_url>
  <action id="site.envywook.MaxSpeedVPN.configure-tun">
    <description>Configure a MaxSpeedVPN TUN session</description>
    <message>Authentication is required to configure MaxSpeedVPN TUN networking</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
