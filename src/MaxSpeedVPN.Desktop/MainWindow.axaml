<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MaxSpeedVPN.Desktop"
        x:Class="MaxSpeedVPN.Desktop.MainWindow"
        Width="1120" Height="760" MinWidth="960" MinHeight="660"
        Background="#080B12" FontFamily="Inter"
        Icon="avares://MaxSpeedVPN.Desktop/Assets/maxspeedvpn.ico"
        Title="MaxSpeedVPN">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border x:Name="SubscriptionOverlay" Grid.RowSpan="3" ZIndex="21" Background="#DC000000" IsVisible="False">
      <Border Width="650" Padding="26" CornerRadius="18" Background="#101522" BorderBrush="#3D647BFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="Добавить сервер или подписку" Classes="dialogTitle" />
          <TextBlock Text="Вставьте ссылку VLESS, Hysteria2, NaiveProxy, Mieru или HTTPS-подписку" Classes="muted" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="SubscriptionUrlTextBox" PlaceholderText="vless://… · hysteria2://… · https://…" />
            <Button Grid.Column="1" Content="Вставить" Classes="secondary" Click="PasteSubscriptionUrl_Click" />
          </Grid>
          <TextBox x:Name="SubscriptionNameTextBox" PlaceholderText="Название (необязательно)" />
          <TextBlock Text="Идентификатор установки передаётся серверу только в служебном заголовке. В интерфейсе он не отображается." Classes="muted" TextWrapping="Wrap" />
          <TextBlock x:Name="SubscriptionErrorText" Classes="error" IsVisible="False" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Отмена" Classes="secondary" Click="CancelSubscription_Click" />
            <Button x:Name="ConfirmSubscriptionButton" Content="Добавить" Classes="primary" Click="ConfirmImportSource_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Background="#0C1019" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1" Padding="28,16">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Image Width="36" Height="36" Source="avares://MaxSpeedVPN.Desktop/Assets/maxspeedvpn.png" />
          <TextBlock Text="MaxSpeedVPN" Foreground="#FAFBFF" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="Локальный proxy · 127.0.0.1:10808" Foreground="#778399" FontSize="12" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="28,10,28,8">
      <TabItem Header="Подключение">
        <Grid Margin="2,12,2,0" ColumnDefinitions="0.86*,1.14*" ColumnSpacing="18">
          <Border Classes="panel" Padding="26">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel Spacing="5">
                <TextBlock Text="СОСТОЯНИЕ" Classes="eyebrow" />
                <TextBlock x:Name="StatusText" Text="Не подключено" Classes="title" />
              </StackPanel>
              <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                <Button x:Name="ConnectButton" Classes="connect" Click="Connect_Click" IsEnabled="False" AutomationProperties.Name="Подключить" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                  <PathIcon Data="M12,2 A10,10 0 1 0 22,12 A10,10 0 0 0 12,2 M12,6 L12,13" Foreground="#F5F7FF" Width="42" Height="42" />
                </Button>
                <TextBlock x:Name="ConnectHint" Text="Сначала добавьте сервер" Foreground="#AAB2C4" FontSize="13" HorizontalAlignment="Center" />
                <Button Content="Добавить сервер или подписку" Classes="primary" Click="OpenImport_Click" />
              </StackPanel>
              <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <StackPanel><TextBlock Text="ПРОКСИ" Classes="eyebrow"/><TextBlock Text="127.0.0.1:10808" Classes="metricValue"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="ЯДРО" Classes="eyebrow"/><TextBlock x:Name="SelectedCoreText" Text="—" Classes="metricValue"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="ПИНГ" Classes="eyebrow"/><TextBlock x:Name="SelectedLatencyText" Text="—" Classes="metricValue"/></StackPanel>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="panel" Padding="22">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="Серверы" Classes="title" />
                  <TextBlock x:Name="ServerCountText" Text="0 сохранено" Classes="muted" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="PingAllButton" Classes="icon" Click="PingAll_Click" ToolTip.Tip="Проверить пинг" AutomationProperties.Name="Проверить пинг">
                  <PathIcon Data="M13,2 L5,14 H11 L10,22 L19,9 H13 Z" Width="18" Height="18" Foreground="#DCE3FF" />
                </Button>
                <ToggleButton Grid.Column="2" x:Name="LivePingToggle" Content="Автопинг" Classes="live" IsCheckedChanged="LivePingToggle_Changed" />
                <Button Grid.Column="3" Content="+ Сервер / подписка" Classes="primary" Click="OpenImport_Click" />
              </Grid>
              <Grid Grid.Row="1" Margin="0,18,0,0">
                <ListBox x:Name="ServersList" SelectionChanged="ServersList_SelectionChanged" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ServerRow">
                      <Border Classes="serverRow" Padding="14" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                          <Border Width="40" Height="40" CornerRadius="11" Background="#18213A"><TextBlock Text="{Binding ProtocolCode}" Foreground="#AEBBFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                          <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" Foreground="#F0F3FA" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Endpoint}" Classes="muted"/></StackPanel>
                          <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="3"><TextBlock Text="{Binding LatencyText}" Foreground="#A9E7CE" HorizontalAlignment="Right"/><TextBlock Text="{Binding ProtocolLabel}" Classes="muted" HorizontalAlignment="Right"/></StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyServersState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                  <TextBlock Text="Серверов пока нет" Foreground="#E4E8F1" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="Добавьте отдельную ссылку или импортируйте подписку" Classes="muted" HorizontalAlignment="Center" />
                  <Button Content="Добавить сервер или подписку" Classes="primary" Click="OpenImport_Click" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Подписки">
        <Grid Margin="2,12,2,0" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="4"><TextBlock Text="Подписки" Classes="pageTitle"/><TextBlock x:Name="SubscriptionCountText" Text="0 добавлено" Classes="muted"/></StackPanel>
            <Button Grid.Column="1" Content="+ Добавить сервер или подписку" Classes="primary" Click="OpenImport_Click" />
          </Grid>
          <Border Grid.Row="1" Classes="panel" Padding="20">
            <Grid>
              <ListBox x:Name="SubscriptionsList" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:SubscriptionRow">
                    <Border Classes="serverRow" Padding="16" Margin="0,0,0,9">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4"><TextBlock Text="{Binding Name}" Foreground="#F2F4FA" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding DisplayHost}" Classes="muted"/><TextBlock Text="{Binding UpdatedText}" Classes="muted"/></StackPanel>
                        <Button Grid.Column="1" Content="Обновить" Tag="{Binding Id}" Classes="secondary" Click="RefreshSubscription_Click" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel x:Name="EmptySubscriptionsState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="11">
                <TextBlock Text="Подписок пока нет" Foreground="#E4E8F1" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Вставьте ссылку Remnawave или обычную base64/plain подписку" Classes="muted" HorizontalAlignment="Center" />
                <Button Content="Добавить сервер или подписку" Classes="primary" Click="OpenImport_Click" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Настройки">
        <ScrollViewer Margin="2,12,2,0">
          <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Spacing="4"><TextBlock Text="Настройки" Classes="pageTitle"/><TextBlock Text="Параметры ядра, маршрутизации и обновления подписок" Classes="muted"/></StackPanel>
            <Border Classes="panel" Padding="22">
              <StackPanel Spacing="12"><TextBlock Text="Ядро" Classes="sectionTitle"/><ComboBox x:Name="CorePreferenceBox" SelectedIndex="0"><ComboBoxItem Content="Автоматически"/><ComboBoxItem Content="sing-box"/><ComboBoxItem Content="Xray"/></ComboBox><TextBlock Text="Автовыбор учитывает протокол профиля и доступные локальные ядра." Classes="muted" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Classes="panel" Padding="22">
              <StackPanel Spacing="11"><TextBlock Text="Маршрутизация локального proxy" Classes="sectionTitle"/><RadioButton x:Name="RussiaDirectRadio" Content="Напрямую — локальный proxy обходит VPN-сервер" GroupName="RussiaRouting"/><RadioButton x:Name="RussiaAllTrafficRadio" Content="Через VPN — весь трафик локального proxy, локальные сети напрямую" GroupName="RussiaRouting" IsChecked="True"/><RadioButton x:Name="RussiaOnlyUnavailableRadio" Content="Только недоступные сайты — пока недоступно" GroupName="RussiaRouting" IsEnabled="False"/><CheckBox x:Name="PrivateNetworksDirectCheckBox" Content="Локальные и частные сети напрямую" IsChecked="True" IsEnabled="False"/><TextBlock Text="Это правила для proxy 127.0.0.1:10808. System-wide TUN ещё не включён." Classes="muted" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Classes="panel" Padding="22">
              <StackPanel Spacing="11"><TextBlock Text="Подписки" Classes="sectionTitle"/><CheckBox x:Name="AutoUpdateSubscriptionsCheckBox" Content="Обновлять подписки при запуске" IsChecked="True"/><TextBlock Text="Локальный идентификатор установки создаётся автоматически и не показывается в интерфейсе." Classes="muted" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Button Content="Сохранить настройки" Classes="primary" Click="SaveSettings_Click" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Margin="28,0,28,14" Background="#0D121D" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8" IsHitTestVisible="False">
      <TextBlock x:Name="EventText" Text="Готово." Foreground="#98A3B8" FontSize="11" TextWrapping="Wrap" />
    </Border>
  </Grid>

  <Window.Styles>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#0C111B"/><Setter Property="BorderBrush" Value="#24FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/></Style>
    <Style Selector="Border.serverRow"><Setter Property="Background" Value="#101622"/><Setter Property="BorderBrush" Value="#1DFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
    <Style Selector="Border.serverRow:pointerover"><Setter Property="Background" Value="#151D2E"/><Setter Property="BorderBrush" Value="#48647BFF"/></Style>
    <Style Selector="TextBlock.pageTitle"><Setter Property="Foreground" Value="#F3F5FA"/><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.title"><Setter Property="Foreground" Value="#F3F5FA"/><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.dialogTitle"><Setter Property="Foreground" Value="#F6F8FF"/><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.sectionTitle"><Setter Property="Foreground" Value="#E9EDF5"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="Foreground" Value="#8995AA"/><Setter Property="FontSize" Value="10"/><Setter Property="LetterSpacing" Value="1.2"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#8C98AD"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="#FF9AAB"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBlock.metricValue"><Setter Property="Foreground" Value="#DCE1EB"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#566BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16,10"/></Style>
    <Style Selector="Button.secondary"><Setter Property="Background" Value="#111824"/><Setter Property="Foreground" Value="#D2D8E4"/><Setter Property="BorderBrush" Value="#32FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="15,9"/></Style>
    <Style Selector="Button.icon"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Background" Value="#111824"/><Setter Property="BorderBrush" Value="#32FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10"/></Style>
    <Style Selector="ToggleButton.live"><Setter Property="MinHeight" Value="42"/><Setter Property="Background" Value="#111824"/><Setter Property="Foreground" Value="#D2D8E4"/><Setter Property="BorderBrush" Value="#32FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="13,8"/></Style>
    <Style Selector="ToggleButton.live:checked"><Setter Property="Background" Value="#17372C"/><Setter Property="Foreground" Value="#A9E7CE"/><Setter Property="BorderBrush" Value="#388F70"/></Style>
    <Style Selector="Button.connect"><Setter Property="Width" Value="108"/><Setter Property="Height" Value="108"/><Setter Property="Background" Value="#11182A"/><Setter Property="BorderBrush" Value="#566BFF"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="54"/></Style>
    <Style Selector="Button.connect:disabled"><Setter Property="Background" Value="#11182A"/><Setter Property="BorderBrush" Value="#566BFF"/><Setter Property="Opacity" Value="0.55"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="14,9"/></Style>
  </Window.Styles>
</Window>
